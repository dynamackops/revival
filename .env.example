# Browser-safe configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_REVIVAL_API_BASE_URL=http://localhost:8000

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EXPECTED_AUDIENCE=authenticated

# Nebius Token Factory
NEBIUS_TOKEN_FACTORY_API_KEY=
NEBIUS_TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_REASONING_MODEL=
NEMOTRON_FAST_MODEL=

# Token Factory Sandboxes (ConTree)
CONTREE_TOKEN=
CONTREE_PROJECT=
CONTREE_IMAGE=tag:ubuntu:latest

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_INSTALLATION_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Signs the short-lived installation "state" value used by the github-app
# Supabase Edge Function. Generate with: openssl rand -hex 32
GITHUB_APP_STATE_SECRET=

# Runtime
REVIVAL_ENV=development
REVIVAL_ALLOWED_ORIGINS=http://localhost:5173
